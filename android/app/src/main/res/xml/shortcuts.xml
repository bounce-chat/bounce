<?xml version="1.0" encoding="utf-8"?>
<!--
  Declares Bounce as a share target so its conversations appear in the system
  Sharesheet's direct-share row.

  The category here must match one of the categories on the published shortcut
  (see Conversations.CATEGORY_SHARE_TARGET) - that pairing is the whole binding
  between "this app accepts shares" and "these particular conversations do".

  mimeType is */* because the engine accepts arbitrary file attachments, not just
  images; a text/plain share arrives the same way and becomes the draft.
-->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <share-target android:targetClass="chat.bounce.ui.MainActivity">
        <data android:mimeType="*/*" />
        <category android:name="chat.bounce.category.SHARE_TARGET" />
    </share-target>
</shortcuts>
